# Environment template — every value is a placeholder. Real values never enter the repo.

# Root of the (private) memory vault — referenced as $VAULT throughout the docs.
VAULT=<ABSOLUTE_PATH_TO_VAULT>

# Headless-Chrome binary for the HTML→PDF render pipeline.
CHROME_PATH=<ABSOLUTE_PATH_TO_CHROME>

# Python used by the verification harness (must have sympy installed).
PYTHON_BIN=<PYTHON_3_11_PATH>

# Messaging-channel credentials (kept in the OS keychain in production,
# never in a file — this entry exists only to document the shape).
MESSAGING_BOT_TOKEN=<NEVER_COMMIT_REAL_TOKENS>
